@@ -179,6 +179,53 @@ static u32 FASTCALL OP_DECODE()
 
 static const ArmOpCompiled op_decode[2][2] = { OP_DECODE<0,0>, OP_DECODE<0,1>, OP_DECODE<1,0>, OP_DECODE<1,1> };
 
+// RetroStation: instrucción que el JIT no traduce, con su código y dirección
+// ya conocidos al compilar el bloque. Antes se llamaba a armcpu_exec(), que
+// volvía a leer la instrucción de memoria, la decodificaba y además leía la
+// siguiente (armcpu_prefetch). Aquí se ejecuta directamente y se deja el
+// mismo estado (instruct_adr, next_instruction, R15) y los mismos ciclos.
+template<int PROCNUM, int thumb>
+static u32 FASTCALL OP_INTERP_KNOWN(u32 opcode, u32 adr)
+{
+   armcpu_t* const cpu = &ARMPROC;
+   const u32 isize = thumb ? 2 : 4;
+   cpu->instruct_adr = adr;
+   cpu->next_instruction = adr + isize;
+   cpu->R[15] = adr + 2 * isize;
+   cpu->instruction = opcode;
+
+   u32 cExecute;
+   if (thumb)
+      cExecute = thumb_instructions_set[PROCNUM][opcode >> 6](opcode);
+   else if (CONDITION(opcode) == 0xE || TEST_COND(CONDITION(opcode), CODE(opcode), cpu->CPSR))
+      cExecute = arm_instructions_set[PROCNUM][INSTRUCTION_INDEX(opcode)](opcode);
+   else
+      cExecute = 1;
+
+   // Lo que haría armcpu_prefetch(), salvo leer el código de la siguiente
+   // instrucción (el bloque compilado ya lo conoce, o termina aquí).
+   u32 next = cpu->next_instruction;
+   u32 cFetch;
+   if (cpu->CPSR.bits.T == 0)
+   {
+      next &= 0xFFFFFFFC;
+      cpu->instruct_adr = next;
+      cpu->next_instruction = next + 4;
+      cpu->R[15] = next + 8;
+      cFetch = MMU_codeFetchCycles<PROCNUM,32>(next);
+   }
+   else
+   {
+      next &= 0xFFFFFFFE;
+      cpu->instruct_adr = next;
+      cpu->next_instruction = next + 2;
+      cpu->R[15] = next + 4;
+      cFetch = PROCNUM == 0 ? MMU_codeFetchCycles<PROCNUM,32>(next)
+                            : MMU_codeFetchCycles<PROCNUM,16>(next);
+   }
+   return MMU_fetchExecuteCycles<PROCNUM>(cExecute, cFetch);
+}
